Windows Registry Editor Version 5.00

; ====================================================================
; PRO TIER - ULTIMATE HARDWARE & GPU OPTIMIZATION (INTEL + AMD)
; Target Architecture: Intel Processor + AMD Discrete GPU
; Comprehensive 10KB Master Script: GPU Stutter Elimination, WDDM Priority,
; PCIe Power Bypass, DirectX Zero-Latency Queues, and MMCSS High Priority.
; ====================================================================

; --- 1. HARDWARE-SPECIFIC GPU POWERPLAY / STUTTER THRESHOLD ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}\0000]
"PP_MCLKStutterModeThreshold"=dword:00000FA0
"DisableDynamicPstate"=dword:00000001
"EnableUlps"=dword:00000000
"EnableUlps_NA"=dword:00000000
"PP_PhmUseXOClkAddrInterval"=dword:00000001
"PP_DisablePowerStutter"=dword:00000001

; --- 2. WDDM GRAPHICS DRIVER KERNEL SCHEDULING ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"TdrLevel"=dword:00000000
"TdrDelay"=dword:0000000A
"HwSchMode"=dword:00000002
"GpuPreemptionControl"=dword:00000001
"DbsEnabled"=dword:00000001
"PlatformSupportMiracast"=dword:00000000

; --- 3. DIRECTX ZERO-LATENCY FRAME QUEUE & PRESENTATION ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\DirectX]
"MaxFrameQueueSize"=dword:00000001
"EnablePreemption"=dword:00000001
"UseMultiPlaneOverlay"="0"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\HD-Player.exe\PerfOptions]
"CpuPriorityClass"=dword:00000003
"IoPriority"=dword:00000003

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\Ld9BoxHeadless.exe\PerfOptions]
"CpuPriorityClass"=dword:00000003
"IoPriority"=dword:00000003

; --- 4. PCI EXPRESS LINK STATE POWER MANAGEMENT (ASPM BYPASS) ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\ee12f905-d2ef-4450-9eva-85caac63f80d\3b04d4fd-1fcc-4394-91aa-7b593fa81f4b]
"Attributes"=dword:00000002

; --- 5. MMCSS GAMES TASK HIGH PRIORITY OVERRIDES ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games]
"Affinity"=dword:00000000
"Background Only"="No"
"Clock Rate"=dword:00002710
"GPU Priority"=dword:00000008
"Priority"=dword:00000008
"Scheduling Category"="High"
"SFIO Priority"="High"

